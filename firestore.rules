rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'thefeedbuzz.store@gmail.com' ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /profiles/{uid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (isOwner(uid) && (
        request.resource.data.role == resource.data.role ||
        request.auth.token.email == 'thefeedbuzz.store@gmail.com'
      ));
    }

    match /favorites/{favId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && (
        isOwner(resource.data.userId) || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
      ));
      allow delete: if isAdmin() || (isSignedIn() && isOwner(resource.data.userId));
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
    }

    match /lists/{listId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
    }

    match /affiliate_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /affiliate_clicks/{clickId} {
      allow read: if isAdmin();
      allow create: if true; // Allow tracking clicks even for anonymous users
    }
  }
}
